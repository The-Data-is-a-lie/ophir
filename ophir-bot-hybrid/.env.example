# ── Copy to ophir-bot-hybrid/.env and fill in. .env is gitignored — never commit real keys. ──
# FRESH Alpaca PAPER account for the hybrid model. Paper keys start with "PK".
#
# This bot runs from a SEPARATE checkout (e.g. ~/ophir-hybrid) with its own
# .ophir data/model/audit, so it is fully isolated from the primary burn-in.
# The gate refuses to start against a live endpoint unless AGENT_ALLOW_LIVE=true.
AGENT_MODE=paper
AGENT_DRY_RUN=true
AGENT_ALLOW_LIVE=false
AGENT_ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2
AGENT_ALPACA_KEY_ID=PKxxxxxxxxxxxxxxxxxxxx
AGENT_ALPACA_SECRET_KEY=your_fresh_paper_secret_here
# Per-stock dossiers + trade tracker land here (kept out of the primary reports).
# rebalance.sh defaults this to <this dir>/reports if unset.
# AGENT_REPORT_DIR=/home/you/ophir-hybrid/ophir-bot-hybrid/reports
